# Copy to computer_use_agent/.env and edit. Every key below is optional except
# GOOGLE_CLOUD_PROJECT -- the code deliberately assumes no default project.

# ============================================================
# Vertex AI
# ============================================================
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=
# Location is pinned to "global" in config.py and is NOT read from here.
# Computer Use is preview-only on the global endpoint. "global" means Google
# routes by capacity with no geographic guarantee -- confirm this is acceptable
# before promising data residency to a customer.
ADK_MODEL=gemini-3.5-flash          # Computer Use fallback navigator
ANALYSIS_MODEL=gemini-3.5-flash     # video understanding

# ============================================================
# Browser
# ============================================================
BROWSER_HEADLESS=true
SCREEN_WIDTH=1920
SCREEN_HEIGHT=1080
ALLOW_PRIVATE_NETWORK_ACCESS=true
# Plan B only: play the page faster so a 3h recording finishes sooner. Costs
# frame detail, and most players cap at 2x-8x. Window seconds are converted
# automatically, so 15s stays 15s of *video* whatever the rate.
PLAYBACK_RATE=1
# Origins that sit behind Google IAM (Cloud Run --no-allow-unauthenticated, or
# IAP). Requests to these carry an `Authorization: Bearer <Google ID token>`;
# requests anywhere else carry nothing, so a public site never sees this
# deployment's identity. Comma-separated, scheme + host, no path. Empty is the
# default and means no origin gets a token.
# OIDC_ORIGINS=https://cctv-demo-video-xxxxxxxx-uc.a.run.app

# ============================================================
# 人工验证闸门
# ============================================================
# 遇到真验证码时怎么办。生产部署在 Agent Engine 上：没有显示器、没有大屏、
# 没人盯着，在那里"等人"不是稳妥，是白烧十五分钟浏览器时间再报同一个错。
#   auto -- 探测大屏是否活着，活着才等（默认）
#   wait -- 一律等，哪怕没有大屏（本机调试用）
#   off  -- 一律不等，出现验证码立刻失败
# 生产的正解不是这个开关，而是让验证码根本不出现：线下人工登录一次导出
# storage_state，从 Secret Manager 挂到 AUTH_STATE_DIR；以及向平台申请稽核
# 专用账号 + 出口 IP 白名单。
HUMAN_GATE_MODE=auto
HUMAN_GATE_TIMEOUT_SECONDS=900

# ============================================================
# Capture
# ============================================================
CAPTURE_MODE=auto            # auto | stream (Plan A) | screen (Plan B)
WINDOW_SECONDS=15            # analysis window, in video seconds; 600 is fine
WINDOW_OVERLAP_SECONDS=3     # keeps a boundary-straddling action visible to one window
CAPTURE_FPS=5                # frames pulled off CDP for the recording (Plan B)
STREAM_PROBE_SECONDS=12      # how long to watch for an HLS/FLV/DASH request
# Crop the recording to the player's bounding box. A full-page capture spends
# most of its pixels on headers and sidebars, and the model downsamples the
# whole frame -- which is how a gloved hand and a bare one come out identical.
FULLSCREEN_PLAYER=true       # make the player fill the viewport; falls back to cropping
CROP_TO_PLAYER=true
# A finished <video> renders its last frame forever. Without this the recorder
# keeps encoding (and billing for) identical windows until a budget fires.
STOP_ON_VIDEO_END=true
PAGE_WATCH_SECONDS=5         # also how often login nags get dismissed mid-run

# ============================================================
# Analysis
# ============================================================
ANALYSIS_CONCURRENCY=3       # windows analysed at once
ANALYSIS_FPS=1               # frames per video-second sent to Gemini
# low (~66 tok/frame) | medium | high (~258 tok/frame).
# `low` is fine for gross behaviour (on the phone, nobody at the station) but
# not for small details -- gloves, mask edges, whether a lid is on. Use `high`
# whenever the SOP turns on something you would have to lean in to see.
MEDIA_RESOLUTION=high
CLIP_QUEUE_SIZE=8            # backpressure: capture blocks when analysis lags

# ============================================================
# Budget guards -- all hard stops
# ============================================================
MAX_WALL_CLOCK_SECONDS=3600
MAX_COST_TOKENS=             # blank = unlimited
MAX_WINDOWS=                 # blank = unlimited

# ============================================================
# Paths
# ============================================================
AUTH_STATE_DIR=./auth        # storage_state files: live session cookies, chmod 600, gitignored
DATA_DIR=                    # records + evidence frames; default computer_use_agent/checkpoints
WORK_DIR=                    # scratch clips; default ./.work
KEEP_CLIPS=false             # true keeps window MP4s for debugging (uses real disk)
# The audit standard. This file is the ONLY source of audit criteria -- text
# typed into the chat box is read for a URL and a time range and nothing else.
SOP_RULES_PATH=              # default computer_use_agent/analyzer/sop_rules.yaml

# ============================================================
# Live monitor
# ============================================================
# The dashboard streams CCTV frames containing identifiable faces. Keep it on
# localhost. If you must expose it, set MONITOR_TOKEN and front it with an
# authenticating proxy.
MONITOR_HOST=127.0.0.1
MONITOR_PORT=8080
MONITOR_TOKEN=               # required to write to /api/event and /api/interact when set
# Dashboard preview. This is a SECOND, independent screencast, so none of it
# touches the evidence feed -- turning it down does not make the audit worse,
# and turning it up does not make the audit slower. Measured on a 1080p video
# page: 960x540 q60 is ~58 KB a frame, 640x360 q50 is ~27 KB. Multiply by
# PREVIEW_FPS for the bandwidth your viewer needs (over an SSH tunnel, mind).
PREVIEW_FPS=15
PREVIEW_WIDTH=960
PREVIEW_HEIGHT=540
PREVIEW_QUALITY=60           # 10-95; drop to 640/360/50 on a slow tunnel
# The dashboard is a live view of the run in progress. Turning this on replays
# the whole append-only trail at startup, including runs graded against a
# different SOP file -- useful for review, misleading during an audit.
MONITOR_REPLAY_HISTORY=false

# ============================================================
# Computer Use fallback (used only when the deterministic navigator fails)
# ============================================================
FALLBACK_MAX_TURNS=25
ENABLE_INJECTION_DETECTION=true
