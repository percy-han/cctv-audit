# Belt and braces with .gcloudignore: that one governs what reaches Cloud
# Build, this one what reaches the image. A local `docker build` obeys only
# this file, so the secrets have to be listed in both.
auth/
cctv_audit/.env
*.env
cctv_audit/checkpoints/
.work/
.venv/
.git/
.pytest_cache/
__pycache__/
*.pyc

# Local `adk web` state: a session database from this workstation. It is not a
# secret, but it does get COPYed into the image, where it is one more file
# nobody put there on purpose.
cctv_audit/.adk/
.DS_Store
